Options -Indexes

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Direct requests for the theme's HTML copies go to the public page.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^prices\.html$ /prices/ [R=301,L]
RewriteRule ^offers\.html$ /offers/ [R=301,L]
RewriteRule ^team\.html$ /team/ [R=301,L]
RewriteRule ^about\.html$ /about/ [R=301,L]
RewriteRule ^contact\.html$ /contact/ [R=301,L]
RewriteRule ^questions\.html$ /questions/ [R=301,L]
RewriteRule ^patch\.html$ /patch/ [R=301,L]
RewriteRule ^terms\.html$ /terms/ [R=301,L]
RewriteRule ^privacy\.html$ /privacy/ [R=301,L]
RewriteRule ^(haircut|hair-colour|balayage|hair-smoothing)-ealing\.html$ /$1-ealing/ [R=301,L]
RewriteRule ^404\.html$ / [R=301,L]
RewriteRule ^sitemap\.xml$ /sitemap.xml [R=301,L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 7 days"
</IfModule>
